#!/bin/sh
mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mount -t configfs configfs /sys/kernel/config 2>/dev/null || true

[ -c /dev/console ] || mknod -m 600 /dev/console c 5 1
exec >/dev/console 2>/dev/console

echo "DROIDIAN: init started" > /dev/kmsg
echo "Droidian initramfs starting..."

# Force USB peripheral mode
for p in /sys/class/usb_role/*/role; do
    echo "device" > "$p" 2>/dev/null || true
done

# Wait up to 15s for any UFS/SCSI block device to appear
echo "DROIDIAN: waiting for block devices" > /dev/kmsg
i=0
while [ $i -lt 150 ]; do
    ls /dev/block/sd* >/dev/null 2>&1 && break
    sleep 0.1
    i=$((i + 1))
done

# Log all found block devices
echo "DROIDIAN: block devices: $(ls /dev/block/sd* 2>/dev/null | tr '\n' ' ')" > /dev/kmsg
echo "Block devices found: $(ls /dev/block/sd* 2>/dev/null | tr '\n' ' ')"

# Write marker to first available block device sector 0 for debug
FIRSTDEV=$(ls /dev/block/sd* 2>/dev/null | head -1)
if [ -n "$FIRSTDEV" ]; then
    /bin/busybox printf "DROIDIAN:BLKDEV_OK:${FIRSTDEV}\n" | \
        /bin/busybox dd of="$FIRSTDEV" bs=512 count=1 2>/dev/null || true
fi

# Find userdata by ext4 label "droidian"
USERDATA=""
for dev in /dev/block/sd*; do
    [ -b "$dev" ] || continue
    LABEL=$(/bin/busybox blkid "$dev" 2>/dev/null | /bin/busybox grep -o 'LABEL="[^"]*"' | /bin/busybox sed 's/LABEL="//;s/"//')
    echo "DROIDIAN: $dev label=$LABEL" > /dev/kmsg
    if [ "$LABEL" = "droidian" ]; then
        USERDATA="$dev"
        break
    fi
done

# Fallback: try sda14
[ -z "$USERDATA" ] && [ -b /dev/block/sda14 ] && USERDATA=/dev/block/sda14

echo "DROIDIAN: userdata=$USERDATA" > /dev/kmsg
echo "Userdata device: ${USERDATA:-not found}"

if [ -z "$USERDATA" ]; then
    echo "ERROR: could not find Droidian userdata partition"
    exec /bin/sh
fi

echo "Mounting Droidian rootfs..."
mkdir -p /newroot
if ! mount -t ext4 -o rw,noatime "$USERDATA" /newroot; then
    echo "DROIDIAN: mount failed on $USERDATA" > /dev/kmsg
    echo "ERROR: ext4 mount failed"
    exec /bin/sh
fi

echo "$(cat /proc/uptime) init_ran $USERDATA" > /newroot/droidian_boot_debug.txt
echo "DROIDIAN: switch_root" > /dev/kmsg

echo "Switching root..."
umount /proc /sys 2>/dev/null || true
exec switch_root /newroot /sbin/init
