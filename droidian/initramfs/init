#!/bin/sh
mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true

# Ensure console is available
[ -c /dev/console ] || mknod -m 600 /dev/console c 5 1

exec >/dev/console 2>/dev/console

echo "Droidian initramfs: waiting for userdata..."

USERDATA=/dev/block/platform/soc/1da0000.ufshc/by-name/userdata
i=0
while [ ! -b "$USERDATA" ] && [ $i -lt 150 ]; do
    sleep 0.1
    i=$((i + 1))
done

if [ ! -b "$USERDATA" ]; then
    echo "ERROR: $USERDATA not found after 15s — dropping to shell"
    exec /bin/sh
fi

echo "Mounting Droidian rootfs..."
mkdir -p /newroot
if ! mount -t ext4 -o rw,noatime "$USERDATA" /newroot; then
    echo "ERROR: mount failed — dropping to shell"
    exec /bin/sh
fi

echo "Switching root..."
umount /proc /sys 2>/dev/null || true
exec switch_root /newroot /sbin/init
