# OnePlus Kalama OEM config — ported for CLO msm-kernel-6.1
#
# Derived from android13-5.15 arch/arm64/configs/vendor/oplus/kalama_GKI.config
#
# Changes vs 5.15:
#   - Preprocessor #ifdef/#endif guards removed (not valid kconfig syntax outside
#     of Qualcomm's internal build tool); keep all options unconditionally enabled
#     as in production builds. The 5.15 source used a custom preprocessor pass.
#   - Options are unchanged functionally; all OEM modules compile out-of-tree
#     against 6.1 kernel headers (see docs/gki-6.1-upstreaming-status.md)
#
# All modules listed here are in sm8550-modules/oplus/ and are NOT part of
# the CLO msm-kernel-6.1 source. Build them separately with:
#   make -C <6.1-tree> M=sm8550-modules/oplus/<subsystem> modules

CONFIG_OPLUS_SYSTEM_KERNEL=y
CONFIG_OPLUS_SYSTEM_KERNEL_QCOM=y
CONFIG_OPLUS_FEATURE_CMDLINE=y
CONFIG_OPLUS_FEATURE_OPROJECT=m
CONFIG_OPLUS_FEATURE_PROJECTINFO=m
CONFIG_OPLUS_FEATURE_OPLUSBOOT=m
CONFIG_OPLUS_FEATURE_FTMMODE=m
CONFIG_OPLUS_FEATURE_BUILDVARIANT=m
CONFIG_OPLUS_FEATURE_CDT=m
CONFIG_OPLUS_FEATURE_SHUTDOWN_DETECT=m
CONFIG_OPLUS_FEATURE_PHOENIX=m
CONFIG_OPLUS_FEATURE_DUMP_REASON=m
CONFIG_OPLUS_FEATURE_KMSG_WB=m

CONFIG_OPLUS_CHG=m
CONFIG_OPLUS_SM8550_CHARGER=y
CONFIG_OPLUS_CHIP_SOC_NODE=y
CONFIG_OPLUS_SHIP_MODE_SUPPORT=y
CONFIG_OPLUS_SMART_CHARGER_SUPPORT=y
CONFIG_OPLUS_CHG_DRM_PANEL_NOTIFY=y
CONFIG_OPLUS_CALL_MODE_SUPPORT=y
CONFIG_OPLUS_CHECK_CHARGERID_VOLT=y
CONFIG_OPLUS_CHG_DYNAMIC_CONFIG=y
CONFIG_OPLUS_CHG_V2=m
CONFIG_OPLUS_SMART_CHARGE=y
CONFIG_OPLUS_ADSP_SM8450_CHARGER=y
CONFIG_OPLUS_CHG_VOOCPHY=y
CONFIG_OPLUS_CHG_AP_VOOCPHY=y
CONFIG_OPLUS_CHG_VOOCPHY_CHGLIB=y
CONFIG_OPLUS_VOOCPHY_SC8517=y
CONFIG_OPLUS_VOOCPHY_MAX77939=y
CONFIG_OPLUS_AUDIO_SWITCH_GLINK=y
CONFIG_OPLUS_UFCS_CLASS=m
CONFIG_OPLUS_UFCS_SC2201=y
CONFIG_OPLUS_UFCS_MASTER_NU2112A=y
CONFIG_OPLUS_UFCS_SLAVE_NU2112A=y
CONFIG_OPLUS_TPS6128XD_CHARGER=y
CONFIG_OPLUS_CHG_MMS_DEBUG=y
CONFIG_OPLUS_CHG_IC_DEBUG=y

CONFIG_AW8697_HAPTIC=m
CONFIG_HAPTIC_FEEDBACK=m

CONFIG_HORAE_THERMAL_SHELL=m

CONFIG_OPLUS_SENSOR_CONSUMER_IR_CORE=m
CONFIG_OPLUS_SENSOR_CONSUMER_IR_QC=m
CONFIG_OPLUS_FEATURE_SENSOR_CFG=m
CONFIG_SSC_INTERACTIVE=m
CONFIG_OPLUS_SENSOR_DRM_PANEL_NOTIFY=m
CONFIG_OPLUS_SENSOR_FB_QC=m

CONFIG_OPLUS_DEVICE_IFNO=m
CONFIG_OPLUS_FW_UPDATE=m
CONFIG_TOUCHPANEL_SYNAPTICS=m
CONFIG_TOUCHPANEL_SYNAPTICS_TCM_ONCELL=m
CONFIG_TOUCHPANEL_SYNAPTICS_TCM_S3910=m
CONFIG_TOUCHPANEL_GOODIX=m
CONFIG_TOUCHPANEL_GOODIX_GT9966=m
CONFIG_TOUCHPANEL_GOODIX_GT9916=m
CONFIG_TOUCHPANEL_OPLUS=m
CONFIG_TOUCHIRQ_UPDATE_QOS=y
CONFIG_TOUCHPANEL_CUSTOM=m
CONFIG_TOUCHPANEL_NOTIFY=m
CONFIG_OPLUS_TRIKEY_MAIN=m
CONFIG_OPLUS_TRIKEY_HALL=m
CONFIG_IST_UP=m
CONFIG_IST_DOWN=m
CONFIG_MXM_UP=m
CONFIG_MXM_DOWN=m
CONFIG_TOUCHSCREEN_SYNA_TCM2=m

CONFIG_UFF_FINGERPRINT=m
CONFIG_UFF_FINGERPRINT_QCOM=y
CONFIG_OPLUS_FINGERPRINT_GKI_ENABLE=y

CONFIG_OPLUS_RF_CABLE_MONITOR=m

CONFIG_SIM_DETECT=m
CONFIG_OEM_QMI=m

CONFIG_OPLUS_GPIO=m

CONFIG_OPLUS_NFC=m

CONFIG_INPUT_QPNP_POWER_ON=m
CONFIG_OPLUS_FEATURE_DUMP_DEVICE_INFO=m
CONFIG_OPLUS_FEATURE_THEIA=m

CONFIG_OPLUS_FEATURE_FEEDBACK=m

CONFIG_OPLUS_FEATURE_OLC=m

CONFIG_OPLUS_FEATURE_LAST_BOOT_REASON=m

CONFIG_LEDS_AW210XX=m

CONFIG_OPLUS_IPA_THERMAL=m

CONFIG_OPLUS_SECURE_COMMON=m
CONFIG_OPLUS_SECURE_QCOM=y
CONFIG_QCOM_QSEELOG_ENCRYPT=y

# Disable debugging (production build)
# CONFIG_ARM_QCOM_CPUFREQ_HW_DEBUG is not set
# CONFIG_SPMI_MSM_PMIC_ARB_DEBUG is not set
# CONFIG_QCOM_ESOC_DEBUG is not set
# CONFIG_QTI_BATTERY_GLINK_DEBUG is not set
# CONFIG_QTI_PMIC_GLINK_DEBUG is not set
# CONFIG_QTI_RIMPS_LOG is not set
# CONFIG_INTERCONNECT_QCOM_DEBUG is not set
# CONFIG_RCU_TRACE is not set
# CONFIG_PID_IN_CONTEXTIDR is not set
# CONFIG_CORESIGHT is not set
# CONFIG_KUNIT is not set

CONFIG_LOG_BUF_SHIFT=20
